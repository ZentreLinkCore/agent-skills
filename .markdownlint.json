{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,

  "MD004": { "style": "dash" },
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD029": { "style": "ordered" },
  "MD033": false,
  "MD035": { "style": "---" },

  /* Specs and rules use bold labels as sub-structure by design — the webkit.spec
     template mandates "**Option A — <label> (Recommended)**" above each pros/cons
     table, and the rule files use "**Applies to:**" callouts. These are deliberate,
     not headings in disguise. */
  "MD036": false,

  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },
  "MD060": { "style": "compact" }
}
